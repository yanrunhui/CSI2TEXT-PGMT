\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of \textsc  {CSI2Text-PGMT}{}. Stage A phase-aligns, frequency-resamples, and transforms the heterogeneous CSI into unified beam-frequency tokens while retaining a raw-power bypass. Stage B uses configuration conditioning and a shared Transformer encoder; text and prototype embeddings provide semantic supervision only during training. Stage C maps the shared CSI embedding to temporal, angular, and power/structure predictions, applies relational correction, and deterministically verbalizes the corrected physical record. Solid arrows denote the test-time inference path, dashed arrows denote training-only semantic alignment, and the red arrow shows the backpropagation update to attention.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:method-overview}{{1}{3}{Overview of \model {}. Stage A phase-aligns, frequency-resamples, and transforms the heterogeneous CSI into unified beam-frequency tokens while retaining a raw-power bypass. Stage B uses configuration conditioning and a shared Transformer encoder; text and prototype embeddings provide semantic supervision only during training. Stage C maps the shared CSI embedding to temporal, angular, and power/structure predictions, applies relational correction, and deterministically verbalizes the corrected physical record. Solid arrows denote the test-time inference path, dashed arrows denote training-only semantic alignment, and the red arrow shows the backpropagation update to attention}{figure.caption.1}{}}
