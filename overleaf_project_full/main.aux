\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Main balanced-split physical results. Learned methods report mean $\pm $ sample standard deviation over three seeds; the deterministic IFFT--PDP baseline is evaluated once on 10,000 test examples. Lower is better for MAE; higher is better for reflection-bin accuracy. Underlining marks the best result across all methods, including ours. The final row gives the relative change from the best prior method, with direction indicated by color (red: improvement; blue: degradation).}}{4}{table.caption.2}\protected@file@percent }
\newlabel{tab:physical-main}{{I}{4}{Main balanced-split physical results. Learned methods report mean $\pm $ sample standard deviation over three seeds; the deterministic IFFT--PDP baseline is evaluated once on 10,000 test examples. Lower is better for MAE; higher is better for reflection-bin accuracy. Underlining marks the best result across all methods, including ours. The final row gives the relative change from the best prior method, with direction indicated by color (red: improvement; blue: degradation)}{table.caption.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {IV-A}2}Comparison with General-Purpose Language Models}{4}{subsubsection.4.1.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Structured prediction versus direct general-purpose language decoding on the common 1,000-example cohort. Panel A reports description-level quality; Panel B reports field-level error. Higher is better for accuracy and slot F1; lower is better for hallucination and MAE. Underlining marks the best result across all methods, including ours. Signed changes are computed against the best direct decoder; direction is indicated by color (red: improvement; blue: degradation).}}{5}{table.caption.3}\protected@file@percent }
\newlabel{tab:decoder-overall}{{II}{5}{Structured prediction versus direct general-purpose language decoding on the common 1,000-example cohort. Panel A reports description-level quality; Panel B reports field-level error. Higher is better for accuracy and slot F1; lower is better for hallucination and MAE. Underlining marks the best result across all methods, including ours. Signed changes are computed against the best direct decoder; direction is indicated by color (red: improvement; blue: degradation)}{table.caption.3}{}}
\newlabel{tab:decoder-fields}{{II}{5}{Structured prediction versus direct general-purpose language decoding on the common 1,000-example cohort. Panel A reports description-level quality; Panel B reports field-level error. Higher is better for accuracy and slot F1; lower is better for hallucination and MAE. Underlining marks the best result across all methods, including ours. Signed changes are computed against the best direct decoder; direction is indicated by color (red: improvement; blue: degradation)}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {IV-A}3}Measured Inference Cost}{5}{subsubsection.4.1.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Measured end-to-end inference cost. Conventional models use FP32, whereas direct language decoders use 4-bit NF4 weights with BF16 computation. Lower is better. Underlining marks the best result across all methods, including ours. The final row compares \textsc  {CSI2Text-PGMT}{} with the most efficient direct language decoder for each cost measure.}}{5}{table.caption.4}\protected@file@percent }
\newlabel{tab:inference-cost-main}{{III}{5}{Measured end-to-end inference cost. Conventional models use FP32, whereas direct language decoders use 4-bit NF4 weights with BF16 computation. Lower is better. Underlining marks the best result across all methods, including ours. The final row compares \model {} with the most efficient direct language decoder for each cost measure}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Quality--cost Pareto comparison. The left panel relates description factuality to median inference latency, and the right panel relates numerical tolerance accuracy to latency. Bubble area encodes peak allocated VRAM. The structured model occupies the high-quality, low-latency corner in both views.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:quality-cost-pareto}{{2}{5}{Quality--cost Pareto comparison. The left panel relates description factuality to median inference latency, and the right panel relates numerical tolerance accuracy to latency. Bubble area encodes peak allocated VRAM. The structured model occupies the high-quality, low-latency corner in both views}{figure.caption.5}{}}
